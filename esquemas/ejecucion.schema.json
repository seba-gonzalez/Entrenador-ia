{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seba-gonzalez/entrenador-ia/esquemas/ejecucion.schema.json",
  "title": "ejecucion",
  "description": "Registro de lo que ocurrio en la realidad (ARQUITECTURA.md 5.5). Nunca modifica la publicacion. Esquema minimo de H1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "sesion_id",
    "publicacion_ejecutada",
    "publicacion_hash",
    "check_in",
    "inicio",
    "fin",
    "series",
    "resultado",
    "notas_de_ejecucion",
    "generado_por",
    "generado_en"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "const": 1 },
    "sesion_id": { "type": "string", "minLength": 1 },

    "publicacion_ejecutada": {
      "type": "integer",
      "minimum": 1,
      "description": "Numero de la publicacion vigente al iniciar. Congela contra que se compara toda la evidencia posterior (D-008)."
    },
    "publicacion_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash de la publicacion utilizada, copiado del indice de publicaciones."
    },

    "demo": {
      "type": "boolean",
      "description": "true cuando la ejecucion se registro sobre un caso demo. Una ejecucion demo es sintetica y no puede presentarse como evidencia de ningun alumno real."
    },
    "aviso_demo": { "type": "string", "minLength": 1 },

    "check_in": { "$ref": "#/$defs/checkIn" },

    "inicio": { "$ref": "#/$defs/campoOpcionalDeFecha" },
    "fin": { "$ref": "#/$defs/campoOpcionalDeFecha" },

    "series": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/serie" }
    },

    "resultado": {
      "enum": ["completada", "parcial", "pospuesta", "omitida"],
      "description": "Posponer y omitir son resultados legitimos y registrables, no fallos. Lo elige una persona: ningun proceso lo deduce."
    },

    "notas_de_ejecucion": { "$ref": "#/$defs/campoOpcionalDeTexto" },

    "generado_por": { "type": "string", "minLength": 1 },
    "generado_en": { "$ref": "#/$defs/fechaISO" }
  },

  "$defs": {
    "fechaISO": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },

    "checkIn": {
      "type": "object",
      "description": "Distingue dos hechos que no son el mismo: si se solicito un check-in, y -solo si se solicito- que hizo la persona con el. 'No se solicito' no vive dentro del enum de respuesta y no se representa con null (D-020).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["solicitado", "motivo"],
          "properties": {
            "solicitado": { "const": false },
            "motivo": {
              "type": "string",
              "minLength": 1,
              "description": "Por que no se solicito. Obligatorio: sin motivo, 'no hubo check-in' seria indistinguible de un olvido."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["solicitado", "estado_respuesta"],
          "properties": {
            "solicitado": { "const": true },
            "estado_respuesta": {
              "enum": ["respondido", "parcial", "sin_respuesta"],
              "description": "Estado de la respuesta de la persona. 'sin_respuesta' afirma que se pregunto y no contesto; nunca se lee como conformidad."
            },
            "ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },

    "serie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ejercicio_id", "ejercicio_nombre", "serie", "realizada", "programado", "ejecutado", "motivo_diferencia"],
      "properties": {
        "ejercicio_id": { "type": "string", "minLength": 1 },
        "ejercicio_nombre": { "type": "string", "minLength": 1 },
        "serie": { "type": "integer", "minimum": 1 },
        "realizada": { "type": "boolean" },
        "programado": {
          "type": "array",
          "minItems": 1,
          "description": "Copia literal de programado.por_serie del ejercicio publicado. No se recalcula ni se completa.",
          "items": {
            "type": "object",
            "required": ["campo", "etiqueta", "prescrito"],
            "properties": {
              "campo": { "type": "string", "minLength": 1 },
              "etiqueta": { "type": "string", "minLength": 1 },
              "prescrito": { "type": "boolean" },
              "valor": { "type": "string" },
              "motivo_no_prescrito": { "type": "string" }
            }
          }
        },
        "ejecutado": { "$ref": "#/$defs/ejecutado" },
        "motivo_diferencia": { "$ref": "#/$defs/campoOpcionalDeTexto" }
      }
    },

    "ejecutado": {
      "type": "object",
      "description": "Lo que ocurrio. Un campo en blanco nunca se rellena con cero ni con el valor programado: se declara sin registrar.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "motivo"],
          "properties": {
            "registrado": { "const": false },
            "motivo": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "campos", "campos_sin_registrar"],
          "properties": {
            "registrado": { "const": true },
            "campos": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "campos_sin_registrar": {
              "type": "array",
              "description": "Campos que la persona dejo en blanco en una serie que si realizo. Se nombran para que la ausencia quede escrita.",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },

    "campoOpcionalDeFecha": {
      "type": "object",
      "description": "Momento que puede no haberse medido. Una vista que no observa el inicio real de la sesion declara que no lo observo, en vez de escribir la hora en que se abrio la pagina: eso convertiria una inferencia en un hecho (principio 1.4).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "motivo"],
          "properties": {
            "registrado": { "const": false },
            "motivo": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "fecha"],
          "properties": {
            "registrado": { "const": true },
            "fecha": { "$ref": "#/$defs/fechaISO" }
          }
        }
      ]
    },

    "campoOpcionalDeTexto": {
      "type": "object",
      "description": "Texto que puede no existir. La ausencia se declara con su motivo en lugar de omitirse o quedar en null.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "motivo"],
          "properties": {
            "registrado": { "const": false },
            "motivo": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registrado", "texto"],
          "properties": {
            "registrado": { "const": true },
            "texto": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
